{
  "name": "founders-morning",
  "version": "1.0.0",
  "description": "A private, researched morning reading for Caspal.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node --use-env-proxy src/server.mjs",
    "dev": "node --use-env-proxy --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "simulate": "node scripts/simulate.mjs",
    "init": "node scripts/init.mjs",
    "research": "node --use-env-proxy scripts/research-now.mjs",
    "dev:serverless": "wrangler dev --test-scheduled",
    "build:serverless": "wrangler deploy --dry-run --outdir var/worker-build",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "test:serverless": "node --test test/edge-*.test.mjs",
    "test:browser:serverless": "npm run build:serverless && SERVERLESS_TEST=1 playwright test",
    "deploy:serverless": "wrangler deploy",
    "init:serverless": "node scripts/init-serverless.mjs",
    "build:website": "node website/build.mjs",
    "package:website": "cd website/public_html && rm -f ../omc-advocates-public_html.zip && zip -qr ../omc-advocates-public_html.zip . -x \".DS_Store\"",
    "preview:website": "rm -rf var/omc-preview && PREVIEW=1 WEBSITE_OUT=var/omc-preview node website/build.mjs && cd var/omc-preview && rm -f ../omc-advocates-preview.zip && zip -qr ../omc-advocates-preview.zip .",
    "single:website": "node website/tools/make-single-file.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caspal26/my-App.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Caspal26/my-App/issues"
  },
  "homepage": "https://github.com/Caspal26/my-App#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
