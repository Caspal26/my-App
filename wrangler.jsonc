{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founders-morning",
  "account_id": "a30f47f2928f29681dcb92992e8b8b5e",
  "vars": { "APP_URL": "https://founders-morning.caspal26.workers.dev" },
  "main": "workers/index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founders-morning",
      "database_id": "0753505e-75e1-4c95-b2bc-dbf0233fceb5",
      "migrations_dir": "workers/migrations"
    }
  ],
  "triggers": {
    // Short scheduled invocations; no continuously running application server.
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
